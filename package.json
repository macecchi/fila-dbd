{
  "name": "fila-dbd",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "deploy:api": "bun run --filter @filadbd/api deploy",
    "deploy:api:preview": "bun run --filter @filadbd/api deploy:preview",
    "deploy:migrations": "bun run --filter @filadbd/api deploy:migrations",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "bun-types": "latest",
    "concurrently": "^9.1.2"
  }
}