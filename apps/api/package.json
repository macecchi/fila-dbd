{
  "name": "@filadbd/api",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply fila-dbd --local && wrangler dev --var DEV_MODE:true",
    "migrate:local": "wrangler d1 migrations apply fila-dbd --local",
    "deploy": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:migrations": "wrangler d1 migrations apply fila-dbd --remote --env production",
    "cf-typegen": "wrangler types",
    "dev:login": "bun scripts/dev-login.ts",
    "dev:live": "bun scripts/dev-stream-online.ts",
    "tail": "wrangler tail --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "RUN_EVALS=1 vitest run gemini.eval"
  },
  "dependencies": {
    "@filadbd/shared": "workspace:*",
    "arctic": "^3.5.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.15.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.17",
    "wrangler": "^4.127.1"
  }
}