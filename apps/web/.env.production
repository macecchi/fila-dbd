# PostHog project token for the production build (services/analytics.ts). This is the
# public, write-only ingestion token — it ships in the client bundle by design, so it
# lives in the repo rather than in the Pages dashboard (a Pages env var of the same
# name overrides it). Dev (`vite`) never reads this file, and localhost stays silent
# even in a production build unless VITE_POSTHOG_ALLOW_LOCAL=true.
VITE_POSTHOG_KEY=phc_CCs7f8DwgPzVqFderx2rUX3XNS54raDHYhz8z8sxDTRW
VITE_POSTHOG_HOST=https://us.i.posthog.com
